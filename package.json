{
  "name": "app-construccion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "user:create": "node --experimental-strip-types scripts/create-user.ts",
    "pilot:seed": "node --experimental-strip-types scripts/seed.ts",
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "verify": "npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
